ENVIRONMENT=staging
POSTGRES_USER=staging_app
POSTGRES_PASSWORD=CHANGE_ME_STAGING_POSTGRES_PASSWORD
POSTGRES_DB=ai_business_staging
DATABASE_URL=postgresql://staging_app:CHANGE_ME_STAGING_POSTGRES_PASSWORD@postgres:5432/ai_business_staging
REDIS_PASSWORD=CHANGE_ME_STAGING_REDIS_PASSWORD
MINIO_ROOT_USER=CHANGE_ME_STAGING_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_ME_STAGING_MINIO_SECRET_KEY
JWT_SECRET_KEY=CHANGE_ME_STAGING_JWT_SECRET
COOKIE_SECURE=true
ALLOWED_HOSTS=staging-api.example.com,backend
CORS_ALLOWED_ORIGINS=https://staging.example.com
LOG_FORMAT=json
METRICS_ENABLED=true
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=
NEXT_PUBLIC_API_URL=https://staging-api.example.com
BACKEND_IMAGE=ghcr.io/owner/repository-backend:sha-CHANGE_ME
FRONTEND_IMAGE=ghcr.io/owner/repository-frontend:sha-CHANGE_ME
