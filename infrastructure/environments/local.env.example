ENVIRONMENT=local
POSTGRES_USER=local_app
POSTGRES_PASSWORD=local-postgres-password
POSTGRES_DB=ai_business_local
DATABASE_URL=postgresql://local_app:local-postgres-password@postgres:5432/ai_business_local
REDIS_PASSWORD=local-redis-password
MINIO_ROOT_USER=local-minio-access
MINIO_ROOT_PASSWORD=local-minio-secret-password
JWT_SECRET_KEY=local-jwt-secret-key-for-development-only
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1,backend,testserver
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
LOG_FORMAT=console
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
PGADMIN_EMAIL=admin@local.test
PGADMIN_PASSWORD=local-pgadmin-password
