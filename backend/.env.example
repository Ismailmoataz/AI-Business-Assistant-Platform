# Application identity and environment
PROJECT_NAME=AI Business Assistant Platform
SERVICE_VERSION=1.0.0
ENVIRONMENT=local

# Compose-managed PostgreSQL and optional pgAdmin
POSTGRES_USER=CHANGE_ME_POSTGRES_USER
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
POSTGRES_DB=ai_business
PGADMIN_EMAIL=admin@example.invalid
PGADMIN_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD
DATABASE_URL=postgresql://CHANGE_ME_POSTGRES_USER:CHANGE_ME_POSTGRES_PASSWORD@postgres:5432/ai_business
DATABASE_ECHO=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
DATABASE_POOL_TIMEOUT_SECONDS=30
DATABASE_POOL_RECYCLE_SECONDS=1800
DATABASE_CONNECT_TIMEOUT_SECONDS=5

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DATABASE=0
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD
REDIS_SSL=false
REDIS_CONNECT_TIMEOUT_SECONDS=3
REDIS_SOCKET_TIMEOUT_SECONDS=3
REDIS_HEALTH_CHECK_INTERVAL_SECONDS=30
REDIS_MAX_CONNECTIONS=50
REDIS_MAX_RETRIES=3
REDIS_RETRY_BACKOFF_SECONDS=0.2

# MinIO / S3-compatible object storage
MINIO_ROOT_USER=CHANGE_ME_MINIO_ACCESS_KEY
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_SECRET_KEY
MINIO_ENDPOINT=minio:9000
MINIO_SECURE=false
MINIO_DOCUMENTS_BUCKET=company-documents
MINIO_CONNECT_TIMEOUT_SECONDS=3
MINIO_READ_TIMEOUT_SECONDS=30
MINIO_MAX_CONNECTIONS=20
MINIO_MAX_RETRIES=3
DOCUMENT_MAX_UPLOAD_BYTES=26214400
DOCUMENT_SIGNED_URL_EXPIRY_SECONDS=300

# Identity and browser policy
JWT_SECRET_KEY=CHANGE_ME_TO_AT_LEAST_32_RANDOM_CHARACTERS
JWT_ALGORITHM=HS256
JWT_ISSUER=ai-business-assistant
JWT_AUDIENCE=ai-business-assistant-api
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7
PASSWORD_RESET_EXPIRE_MINUTES=30
INVITATION_EXPIRE_DAYS=7
PASSWORD_MIN_LENGTH=12
COOKIE_SECURE=true
COOKIE_SAMESITE=lax
COOKIE_DOMAIN=
ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SECURITY_HEADERS_ENABLED=true

# Logging, metrics, tracing, and proxy trust
LOG_LEVEL=INFO
LOG_FORMAT=console
FORWARDED_ALLOW_IPS=127.0.0.1
UVICORN_LIMIT_CONCURRENCY=200
UVICORN_TIMEOUT_KEEP_ALIVE=5
UVICORN_TIMEOUT_GRACEFUL_SHUTDOWN=30
METRICS_ENABLED=true
METRICS_BEARER_TOKEN=
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-business-assistant-api
OTEL_EXPORTER_OTLP_ENDPOINT=

# Optional Google OAuth authorization start
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# AI providers. Leave provider names empty to keep AI paths disabled.
CHAT_PROVIDER=
META_API_KEY=
META_BASE_URL=https://api.llama.com/v1
CHAT_MODEL=
CHAT_FALLBACK_MODEL=
EMBEDDING_PROVIDER=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=
AI_CONNECT_TIMEOUT_SECONDS=5
AI_TIMEOUT_SECONDS=30
AI_POOL_TIMEOUT_SECONDS=5
AI_MAX_CONNECTIONS=50
AI_MAX_KEEPALIVE_CONNECTIONS=20
AI_MAX_RETRIES=2
AI_RETRY_BACKOFF_SECONDS=0.5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
EMBEDDING_BATCH_SIZE=32
TOP_K=8
MAX_CONTEXT_SIZE=12000
MINIMUM_SIMILARITY_SCORE=0.2
AI_SYSTEM_PROMPT=

# Frontend/container release values
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000
BACKEND_IMAGE=ai-business-assistant-backend:local
FRONTEND_IMAGE=ai-business-assistant-frontend:local
BACKEND_PORT=8000
FRONTEND_PORT=3000
CONTAINER_LOG_MAX_SIZE=10m
CONTAINER_LOG_MAX_FILES=5
